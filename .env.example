# Varsha Environment Configuration Template
# Copy to .env for real-mode execution with credentials

# Data Operating Mode: synthetic | real
DATA_MODE=synthetic

# NOAA GFS Storage Configuration (Real Mode)
NOAA_GFS_S3_BUCKET=noaa-gfs-bdp-pds
NOAA_AWS_REGION=us-east-1

# IMD Portal Configuration (Real Mode - Optional)
IMD_DATA_DIR=data/raw/imd

# Copernicus Climate Data Store (ERA5 - Optional)
# CDS_API_URL=https://cds.climate.copernicus.eu/api/v2
# CDS_API_KEY=your_uid:your_api_key

# Web & API Server
PORT=8000
HOST=0.0.0.0
